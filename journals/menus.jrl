p({
  "class":"foam.core.menu.Menu",
  "id":"grammaticVisualizer.sentence",
  "label":"Sentence",
  "authenticate":true,
  "keywords":[""],
  "handler":{
    "class":"foam.core.menu.DAOMenu2",
    "config":{
      "class":"foam.comics.v2.DAOControllerConfig",
      "daoKey":"sentenceDAO"
    }
  }
})

// Reflow console - notebook for querying DAOs
p({
  "class":"foam.core.menu.Menu",
  "id":"grammaticVisualizer.reflow",
  "label":"Reflow",
  "authenticate":true,
  "keywords":["reflow","flow","query"],
  "handler":{
    "class":"foam.core.menu.ViewMenu",
    "view":{"class":"foam.core.reflow.Console"}
  }
})

// Railroad grammar viewer (src/foam/parse/rail) as an app screen
p({
  "class":"foam.core.menu.Menu",
  "id":"grammaticVisualizer.grammar",
  "label":"Grammar Visualizer",
  "authenticate":true,
  "keywords":["grammar","railroad","parser","visualizer"],
  "handler":{
    "class":"foam.core.menu.ViewMenu",
    "view":{"class":"com.foamdev.grammaticvisualizer.GrammarVisualizerView"}
  }
})

// Top-level entries for the basic user. They open the same screens as the
// matching Admin entries (same handlers), so the Admin group stays admin-only.
p({"class":"foam.core.menu.Menu","id":"grammaticVisualizer.flows","label":"Flows","authenticate":true,"keywords":["flow","reflow"],
   "handler":{"class":"foam.core.menu.DAOMenu2","config":{"class":"foam.comics.v2.DAOControllerConfig","daoKey":"flowDAO"}}})
p({"class":"foam.core.menu.Menu","id":"grammaticVisualizer.countries","label":"Countries","authenticate":true,"keywords":["country"],
   "handler":{"class":"foam.core.menu.DAOMenu2","config":{"class":"foam.comics.v2.DAOControllerConfig","daoKey":"countryDAO"}}})
p({"class":"foam.core.menu.Menu","id":"grammaticVisualizer.menus","label":"Menus","authenticate":true,"keywords":["menu","navigation"],
   "handler":{"class":"foam.core.menu.DAOMenu","daoKey":"menuDAO","title":"Menus","summaryView":{"class":"foam.core.menu.TreeAltView","relationship":"foam.core.menu.MenuMenuChildrenRelationship"}}})
p({"class":"foam.core.menu.Menu","id":"grammaticVisualizer.customise-theme","label":"Customise Theme","authenticate":true,"keywords":["theme","style"],
   "handler":{"class":"foam.core.menu.DAOMenu2","config":{"class":"foam.comics.v2.DAOControllerConfig","daoKey":"spThemeDAO","browseTitle":"Customise Theme",
     "browseController":{"class":"foam.core.theme.customisation.ThemeCustomisationBrowseController"}}}})
p({"class":"foam.core.menu.Menu","id":"grammaticVisualizer.theme-all","label":"Themes - All","authenticate":true,"keywords":["theme"],
   "handler":{"class":"foam.core.menu.DAOMenu2","config":{"class":"foam.comics.v2.DAOControllerConfig","daoKey":"themeDAO"}}})
p({"class":"foam.core.menu.Menu","id":"grammaticVisualizer.all-views","label":"All Views","authenticate":true,"keywords":["views","demo","u2"],
   "handler":{"class":"foam.core.menu.ViewMenu","view":{"class":"foam.demos.u2.AllViews"}}})
