p({
  "class": "foam.core.boot.CSpec",
  "name": "sentenceDAO",
  "description": "",
  "serve": true,
  "authenticate": true,
  "keywords": [ "sentence" ],
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(com.foamdev.grammaticvisualizer.Sentence.getOwnClassInfo())
      .setPm(true)
      .setSeqNo(true)
      .setAuthorize(false)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .build();
  """,
  "client": `{"of":"com.foamdev.grammaticvisualizer.Sentence"}`
})
