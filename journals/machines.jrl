// Seed machines for the State Machines screen (state machine studio). One line each.
p({"class": "com.foamdev.grammaticvisualizer.fsm.Machine", "id": 1, "name": "Save button", "description": "A Save button: nothing changed, unsaved changes, waiting for the server, the save failed.", "definition": "{\n  \"id\": \"saveButton\",\n  \"description\": \"A Save button: nothing changed, unsaved changes, waiting for the server, the save failed.\",\n  \"initial\": \"clean\",\n  \"states\": {\n    \"clean\": {\n      \"on\": {\n        \"EDIT\": \"dirty\"\n      }\n    },\n    \"dirty\": {\n      \"on\": {\n        \"SAVE\": \"saving\",\n        \"DISCARD\": \"clean\"\n      }\n    },\n    \"saving\": {\n      \"on\": {\n        \"SUCCESS\": \"clean\",\n        \"FAIL\": \"error\"\n      }\n    },\n    \"error\": {\n      \"on\": {\n        \"RETRY\": \"saving\"\n      }\n    }\n  }\n}", "layout": "{\"clean\": {\"x\": 40, \"y\": 60}, \"dirty\": {\"x\": 260, \"y\": 60}, \"saving\": {\"x\": 480, \"y\": 60}, \"error\": {\"x\": 480, \"y\": 220}}"})
p({"class": "com.foamdev.grammaticvisualizer.fsm.Machine", "id": 2, "name": "Login form", "description": "A login form, after David Khourshid's 24ways article (2018).", "definition": "{\n  \"id\": \"loginForm\",\n  \"description\": \"A login form, after David Khourshid's 24ways article (2018).\",\n  \"initial\": \"start\",\n  \"states\": {\n    \"start\": {\n      \"on\": {\n        \"SUBMIT\": \"loading\"\n      }\n    },\n    \"loading\": {\n      \"on\": {\n        \"RESOLVE\": \"success\",\n        \"REJECT\": \"error\"\n      }\n    },\n    \"error\": {\n      \"on\": {\n        \"SUBMIT\": \"loading\"\n      }\n    },\n    \"success\": {\n      \"type\": \"final\"\n    }\n  }\n}", "layout": "{\"start\": {\"x\": 40, \"y\": 60}, \"loading\": {\"x\": 260, \"y\": 60}, \"success\": {\"x\": 480, \"y\": 60}, \"error\": {\"x\": 260, \"y\": 220}}"})
